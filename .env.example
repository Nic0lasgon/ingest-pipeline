# Database
DATABASE_URL=postgres://mypod:mypod_password@localhost:5432/mypod_pipeline

# API
PORT=3000

# Logging
LOG_LEVEL=info

# External services (optional)
# Scrapling Hetzner: extraction contenu sites JavaScript (fallback HTTP strategies)
HETZNER_EXTRACT_URL=https://search.myswearpod.de/extract
HETZNER_EXTRACT_SECRET=your-hetzner-secret-here

# Secrets
PIPELINE_API_SECRET=change-me-in-production
BFF_CRON_SECRET=change-me-in-production

# Scheduler (optional, defaults to 4h cron)
RUN_SCHEDULE=0 2,6,14,20 * * *
